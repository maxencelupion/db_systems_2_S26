datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GroupType {
  CHANNEL
  GROUP
}

generator client {
  provider = "prisma-client-py"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String
  email     String   @unique
  // groupsJoined    GroupJoined[]
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String
  type      GroupType
  // members   GroupJoined[]
}

model Message {
  id    Int     @id @default(autoincrement())
  groupId Int
  senderId  Int
  content String
  timestamp DateTime
  reciverId Int?
  replyId Int?
  reciver User? @relation("reciver", fields: [reciverId], references: [id])
  group group @relation( fields: [groupId], references: [id])
  sender User @relation("sender", fields: [senderId], references: [id])
  reply message? @relation( "MessageReplies",fields: [replyId], references: [id])
  replies message[] @relation("MessageReplies")
}
model GroupJoined {
  id        Int     @id @default(autoincrement())
  groupId Int
  userId  Int
  role Role
  joinedAt DateTime
  group group @relation( fields: [groupId], references: [id])
  user  User   @relation( fields: [userId], references: [id])
  @@unique([groupId, userId])
}

enum Role {
  USER
  ADMIN
  OWNER
} 
