datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum GroupType {
  CHANNEL
  GROUP
}

enum Role {
  USER
  ADMIN
  OWNER
}

generator client {
  provider = "prisma-client-py"
}

model User {
  id               Int           @id @default(autoincrement())
  username         String
  email            String        @unique
  groupsJoined     GroupJoined[]
  sentMessages     Message[]     @relation("sender")
  receivedMessages Message[]     @relation("receiver")
}

model Group {
  id            Int           @id @default(autoincrement())
  name          String
  type          GroupType
  members       GroupJoined[]
  messages      Message[]
  lastMessageAt DateTime?     @updatedAt
}

model Message {
  id         Int       @id @default(autoincrement())
  content    String
  timestamp  DateTime
  sender     User      @relation("sender", fields: [senderId], references: [id])
  senderId   Int
  group      Group     @relation(fields: [groupId], references: [id])
  groupId    Int
  receiver   User?     @relation("receiver", fields: [receiverId], references: [id])
  receiverId Int?
  reply      Message?  @relation("MessageReplies", fields: [replyId], references: [id])
  replyId    Int?
  replies    Message[] @relation("MessageReplies")
}

model GroupJoined {
  id       Int      @id @default(autoincrement())
  role     Role
  joinedAt DateTime
  group    Group    @relation(fields: [groupId], references: [id])
  groupId  Int
  user     User     @relation(fields: [userId], references: [id])
  userId   Int

  @@unique([groupId, userId])
}

model Message {
  id    Int     @id @default(autoincrement())
  groupId Int
  senderId  Int
  content String
  timestamp DateTime
  reciverId Int?
  replyId Int?
  reciver User? @relation("reciver", fields: [reciverId], references: [id])
  group group @relation( fields: [groupId], references: [id])
  sender User @relation("sender", fields: [senderId], references: [id])
  reply message? @relation( "MessageReplies",fields: [replyId], references: [id])
  replies message[] @relation("MessageReplies")
}
model GroupJoined {
  id        Int     @id @default(autoincrement())
  groupId Int
  userId  Int
  role Role
  joinedAt DateTime
  group group @relation( fields: [groupId], references: [id])
  user  User   @relation( fields: [userId], references: [id])
  @@unique([groupId, userId])
}

enum Role {
  USER
  ADMIN
  OWNER
} 
